{
  "name": "Golash",
  "scopeName": "source.goulash",
  "fileTypes": [
    "gsh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functionCalls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goulash",
          "match": "//.*$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.directive.goulash",
          "match": "^\\s*(include|dll|dlldef)\\b"
        },
        {
          "name": "invalid.deprecated.directive.goulash",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goulash",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.goulash",
              "match": "\\\\(\\\\|\"|n|t|r|0)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.goulash",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.goulash",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.goulash",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.goulash",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\.\\d+\\b|\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.goulash",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.goulash",
          "match": "\\b(def|if|elseif|else|end|repeat|while|switch|case|default|as|break|continue|return|local)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.goulash",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.goulash",
          "match": "\\b(abs|args|asc|assert|atan|await|binfile|button|chkbox|chr|clip|closing|cls|color|combox|curdir|cursor|dialog|dim|dirlist|dirmake|dropload|ellipse|env|exec|exedir|exit|exp|filecopy|filedel|find|float|font|fullscreen|getkey|getpath|gettime|gfxblit|gfxcopy|gfxfile|gfxmode|gfxquad|homedir|http|ime|input|inputbox|insert|int|join|len|limit|line|listbox|log|logmsg|lower|max|msg|msgbox|min|sndload|sndplay|sndpitch|sndstop|sndvol|mouse|mousewheel|nanotime|objdel|objenable|objget|objset|open|pad|padaxis|padbtn|pipeexec|pop|pos|pow|print|pget|pset|push|randomize|rect|remove|replace|resizable|reverse|rnd|screen|gfxsel|sleep|slice|sort|split|sqrt|str|strf|strtrim|strwidth|tick|title|tmpdir|touch|tri|txtfile|upper|vartype)\\b"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.goulash",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.goulash",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|==|!=|<=|>=|<<|>>|&&|\\|\\||[+\\-*/%=&|^~!<>]=?"
        },
        {
          "name": "punctuation.goulash",
          "match": "[.,;:()\\[\\]]"
        }
      ]
    }
  }
}
