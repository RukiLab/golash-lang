{
  "name": "Golash",
  "scopeName": "source.goulash",
  "fileTypes": [
    "gsh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functionCalls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goulash",
          "match": "//.*$"
        },
        {
          "name": "comment.block.goulash",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.directive.goulash",
          "match": "^\\s*(#)(include|define|ifdef|ifndef|else|endif|error)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goulash",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.goulash",
              "match": "\\\\(\\\\|\"|n|t|r|0)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.goulash",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.goulash",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.goulash",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.goulash",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\.\\d+\\b|\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.goulash",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.goulash",
          "match": "\\b(def|if|else|repeat|while|switch|case|default|as|break|continue|return)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.goulash",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.goulash",
          "match": "\\b(abs|args|asc|assert|atan|await|bcopy|bload|boxf|bsave|buffer|button|chdir|checked|checksrc|chkbox|chr|circle|clicked|clipget|clipset|closing|clrobj|cls|color|combox|cursor|delete|dialog|dim|direxe|dirlist|dlgopen|dlgsave|dropfiles|dropload|end|exec|exist|exp|find|float|font|fullscreen|galpha|gcopy|gquad|getcwd|getenv|getkey|getpath|getstr|gettext|gettime|gmode|gsel|homedir|httpget|httppost|ime|input|inputbox|insert|instr|int|join|length|lextokens|limit|line|listbox|log|logmes|lower|lpeek|lpoke|max|mes|mesbox|mkdir|min|mmload|mmplay|mmstop|mmvol|mousewheel|mousex|mousey|nanotime|noteadd|notedel|noteget|noteload|notemax|notesave|objprm|open|padaxis|padbtn|padcount|padname|paint|parsetree|peek|picload|pipeexec|piperun|pngsave|poke|pop|pos|pow|pressed|print|pget|pset|push|randomize|remove|replace|resizable|reverse|rnd|screen|screensize|selected|sellist|setenv|setlist|setstr|sleep|slice|sort|split|sqrt|str|strf|strlen|strmid|strtrim|strwidth|tick|title|tmpdir|touchcount|touchx|touchy|upper|vartype|winmove|wpeek|wpoke)\\b"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.goulash",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.goulash",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|==|!=|<=|>=|<<|>>|&&|\\|\\||[+\\-*/%=&|^~!<>]=?"
        },
        {
          "name": "punctuation.goulash",
          "match": "[.,;:(){}\\[\\]]"
        }
      ]
    }
  }
}
